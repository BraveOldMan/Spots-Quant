# Spots-Quant environment template.
# Copy to .env and fill only the values you actually need.
# Never commit .env or real secrets.

# External data APIs.
API_FOOTBALL_KEY=
THE_ODDS_API_KEY=

# API/cache paths.
SPOTS_API_CACHE_DB=api_cache.db
SPOTS_REPORT_DIR=reports

# API-Football today-data daemon.
SPOTS_QUANT_DB=spots_quant.db
SPOTS_API_FOOTBALL_TIMEZONE=Asia/Shanghai
SPOTS_API_FOOTBALL_DAEMON_INTERVAL_MINUTES=15
SPOTS_API_FOOTBALL_DAILY_BUDGET=7000
SPOTS_API_FOOTBALL_MAX_REQUESTS_PER_RUN=250
SPOTS_API_FOOTBALL_REQUEST_DELAY_SECONDS=0.22
SPOTS_API_FOOTBALL_CACHE_ONLY=0
SPOTS_API_FOOTBALL_ENRICHMENT_WINDOW_HOURS=6
SPOTS_API_FOOTBALL_FIXTURES_TTL_SECONDS=60
SPOTS_API_FOOTBALL_ODDS_TTL_SECONDS=180
SPOTS_API_FOOTBALL_LIVE_TTL_SECONDS=300
SPOTS_API_FOOTBALL_PRE_MATCH_TTL_SECONDS=900
SPOTS_API_FOOTBALL_FINISHED_TTL_SECONDS=86400

# Feishu delivery targets.
FEISHU_POLYMARKET_FOOTBALL_CHAT_ID=

# Backtest defaults. These preserve the current baseline when unchanged.
SPOTS_BACKTEST_CSV_PATHS=data_seasons/E0_2223.csv;data_seasons/E0_2324.csv;data_seasons/E0_2425.csv
SPOTS_ODDS_MODE=closing
SPOTS_COMMISSION_ON_WIN=0.0

# Strategy/risk defaults.
SPOTS_EV_THRESHOLD=1.05
SPOTS_MIN_HISTORY=3
SPOTS_INITIAL_CAPITAL=10000.0
SPOTS_KELLY_MULT=0.05
SPOTS_MAX_BET_FRACTION=0.03
SPOTS_MAX_MATCH_EXPOSURE=0.05
SPOTS_MAX_DRAWDOWN_LIMIT=0.15

# Model defaults.
SPOTS_ELO_START=1500.0
SPOTS_ELO_K_DEFAULT=20.0
SPOTS_ELO_HOME_ADV=80.0
SPOTS_HALF_LIFE_DAYS=365.0
SPOTS_DC_RHO=-0.05
SPOTS_GOALS_BLEND=0.6
SPOTS_PXG_BLEND=0.4
SPOTS_PXG_W_ON=0.25
SPOTS_PXG_W_OFF=0.05
SPOTS_SHRINK_K=5.0
SPOTS_DISTILL_FEATURES=elo_diff,mom_diff,rating_diff,mif_home,mif_away

# Cache TTLs in seconds. Use "none" for permanent historical cache.
SPOTS_CACHE_TTL_ODDS=300
SPOTS_CACHE_TTL_FIXTURES=3600
SPOTS_CACHE_TTL_HISTORICAL=none

# Polymarket is dry-run unless ALLOW_REAL_MONEY=1 and all credentials are valid.
ALLOW_REAL_MONEY=0
POLYGON_PRIVATE_KEY=
FUNDER_ADDRESS=
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_CHAIN_ID=137
POLYMARKET_SIGNATURE_TYPE=1
POLYMARKET_RATE_LIMIT_ENABLED=1
POLYMARKET_CLOB_API_KEY=
POLYMARKET_CLOB_API_SECRET=
POLYMARKET_CLOB_API_PASSPHRASE=
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com
POLYMARKET_API_ADDRESS=
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
